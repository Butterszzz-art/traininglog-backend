AIRTABLE_TOKEN=your_airtable_api_token
AIRTABLE_BASE_ID=your_airtable_base_id
JWT_SECRET=your_long_random_secret
# AI (src/coach/client.js). ANTHROPIC_API_KEY, if set, is used alone.
# Otherwise Ollama Cloud is tried first, then Groq (short calls only),
# and OpenRouter takes the overflow.
# Each uses free models unless *_MODELS lists others (comma-separated).
# With Claude: AI_FAST_MODEL (default claude-haiku-5-5) and AI_SMART_MODEL
# (default claude-sonnet-5-5); the coach uses COACH_MODEL (claude-opus-5-5).
# ANTHROPIC_API_KEY=your_anthropic_api_key
OLLAMA_API_KEY=your_ollama_api_key
GROQ_API_KEY=your_groq_api_key
OPENROUTER_API_KEY=your_openrouter_api_key
# OLLAMA_MODELS=gemma4:31b
# GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
# OPENROUTER_MODELS=anthropic/claude-sonnet-5.5
# capacitor://localhost = iOS app, https://localhost = Android app
CORS_ORIGINS=https://pocketcoachcoms.org,https://coaching.pocketcoachcoms.org,http://localhost:3000,http://localhost:5173,https://butterszzz-art.github.io,capacitor://localhost,https://localhost
APP_URL=https://pocketcoachcoms.org

# ── Stripe (web/Android payment rail) ──────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_or_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_from_stripe_dashboard_webhook_config
STRIPE_PRO_MONTHLY_PRICE_ID=price_...
STRIPE_PRO_ANNUAL_PRICE_ID=price_...
STRIPE_COACH_MONTHLY_PRICE_ID=price_...
STRIPE_COACH_ANNUAL_PRICE_ID=price_...

# ── Apple IAP (iOS payment rail — see IAP-SETUP.md) ────────────────────────
APPLE_IAP_ENABLED=false
APPLE_BUNDLE_ID=org.pocketcoachcoms.app
# Numeric Apple ID from App Store Connect → App Information. Without it only
# sandbox (TestFlight / App Review) purchases verify.
APPLE_APP_ID=

# ── Activity Sync / Google Health API (see ACTIVITY-SYNC-SETUP.md, off by default) ──
GOOGLE_HEALTH_CLIENT_ID=your_google_oauth_client_id
GOOGLE_HEALTH_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_HEALTH_REDIRECT_URI=https://your-deployed-function-url/api/activity-sync/callback

# ── Community moderation (App Store Guideline 1.2) ─────────────────────────
# Usernames allowed to remove other users' photos/bios.
PROFILE_ADMINS=your_username
# Every profile report and block is emailed here so someone can act within
# 24 hours, as Apple requires. Sent through Resend (resend.com); the FROM
# domain must be verified there. In production RESEND_API_KEY is a secret:
#   firebase functions:secrets:set RESEND_API_KEY
RESEND_API_KEY=re_...
MODERATION_EMAIL_TO=you@example.com
MODERATION_EMAIL_FROM=Pocket Coach Moderation <moderation@pocketcoachcoms.org>
# Extra words/phrases rejected in usernames, display names and bios, on top of
# the built-in list in src/objectionableTerms.js. Comma-separated; `*` at
# either end matches inside words (e.g. badword*).
OBJECTIONABLE_TERMS=

# ── Plan gating ────────────────────────────────────────────────────────────
# Usernames that get every paid feature (AI, premium library) free.
ADMIN_USERNAMES=your_username

# ── Push notifications (iPhone/iPad, through APNs — see PUSH-SETUP.md) ─────
# Key from developer.apple.com → Certificates, IDs & Profiles → Keys, with
# "Apple Push Notifications service (APNs)" ticked. In production the .p8
# contents are a secret:  firebase functions:secrets:set APNS_KEY < AuthKey_XXXX.p8
# Push stays off until all three are set.
APNS_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=WD37WHSYG7
