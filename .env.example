AIRTABLE_TOKEN=your_airtable_api_token
AIRTABLE_BASE_ID=your_airtable_base_id
JWT_SECRET=your_long_random_secret
ANTHROPIC_API_KEY=your_anthropic_api_key
CORS_ORIGINS=https://pocketcoachcoms.org,http://localhost:3000,http://localhost:5173,https://butterszzz-art.github.io
APP_URL=https://pocketcoachcoms.org

# ── Stripe (web/Android payment rail) ──────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_or_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_from_stripe_dashboard_webhook_config
STRIPE_PRO_MONTHLY_PRICE_ID=price_...
STRIPE_PRO_ANNUAL_PRICE_ID=price_...
STRIPE_COACH_MONTHLY_PRICE_ID=price_...
STRIPE_COACH_ANNUAL_PRICE_ID=price_...

# ── Apple IAP (iOS payment rail — see IAP-SETUP.md, off by default) ────────
APPLE_IAP_ENABLED=false
APPLE_IAP_SANDBOX=true
APPLE_BUNDLE_ID=com.pocketcoach.app

# ── Activity Sync / Google Health API (see ACTIVITY-SYNC-SETUP.md, off by default) ──
GOOGLE_HEALTH_CLIENT_ID=your_google_oauth_client_id
GOOGLE_HEALTH_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_HEALTH_REDIRECT_URI=https://your-deployed-function-url/api/activity-sync/callback

# ── Community moderation (App Store Guideline 1.2) ─────────────────────────
# Usernames allowed to remove other users' photos/bios.
PROFILE_ADMINS=your_username
# Every profile report and block is emailed here so someone can act within
# 24 hours, as Apple requires. Sent through Resend (resend.com); the FROM
# domain must be verified there. In production RESEND_API_KEY is a secret:
#   firebase functions:secrets:set RESEND_API_KEY
RESEND_API_KEY=re_...
MODERATION_EMAIL_TO=you@example.com
MODERATION_EMAIL_FROM=Pocket Coach Moderation <moderation@pocketcoachcoms.org>
# Comma-separated words/phrases rejected in display names and bios.
OBJECTIONABLE_TERMS=
