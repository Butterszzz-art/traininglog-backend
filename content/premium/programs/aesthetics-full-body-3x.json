  "order": 1,
  "title": "Aesthetics Full Body 3x",
  "subtitle": "12 weeks, 3 full-body days per week",
  "audience": "all",
  "goal": "hypertrophy",
  "archetype": "hypertrophy",
  "level": "all",
  "durationWeeks": 12,
  "summary": "The minimal-work, maximum-results option: three full-body sessions a week with a rest day between each. Volume steps up every 4 weeks (8, then 10, then 12 sets). Great for beginners who struggle with consistency.",
  "split": {
    "type": "fullbody",
    "name": "Full Body (3x)",
    "daysPerWeek": 3
  },
  "schedule": {
    "startDate": "",
    "weekdays": [
      1,
      3,
      5
    ]
  },
  "frequency": [
    "Mon",
    "Wed",
