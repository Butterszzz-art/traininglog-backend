  "title": "Aesthetics PPL + Arms: Linear",
  "subtitle": "12 weeks, 7 sessions per week, 12 working sets with rep progression on the main lifts",
  "audience": "all",
  "goal": "hypertrophy",
  "archetype": "hypertrophy",
  "level": "all",
  "durationWeeks": 12,
  "summary": "The same PPL + Arms split with a steady 12 working sets throughout. Progress by adding reps to the main lifts every 4 weeks: squat and RDL from 6 to 8 to 10, incline bench and rows from 8 to 10 to 12.",
  "split": {
    "type": "ppl",
    "name": "Push / Pull / Legs + Arms",
    "daysPerWeek": 5,
    "sessionsPerWeek": 7,
    "label": "7 sessions per week"
  },
  "schedule": {
    "startDate": "",
