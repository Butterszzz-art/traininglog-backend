  "level": "intermediate",
  "durationWeeks": 5,
  "summary": "The mainly-strength half of the power-building plan: bench, rows, squat, overhead press and deadlift in 5x5, 3x3 and single-rep waves at 85-100% of your 1RM, ending in a deload. Run it after the 12-week Hypertrophy Block.",
  "split": {
    "type": "ppl",
    "name": "Push / Pull / Legs (strength)",
    "daysPerWeek": 5,
    "sessionsPerWeek": 6,
    "label": "6 sessions per week"
  },
  "schedule": {
    "startDate": "",
