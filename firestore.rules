// Firestore security rules — Phase 2 of the migration.
//
// Current architecture: the Express backend (Admin SDK) is the only thing
// that reads/writes Firestore today — Admin SDK requests always bypass these
// rules entirely. So right now these rules are a defense-in-depth backstop,
// not an active code path, for whenever the app starts reading Firestore
// directly from the client SDK (e.g. offline-first sync). Default is deny;
// each collection below opts in only what that future access pattern needs.
//
// Deploy with: firebase deploy --only firestore:rules (requires Firebase CLI
// logged in and linked to the project — see FIREBASE-SETUP.md).
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // usernames/{username} — pure uniqueness index for signup-complete.
    // Server-only (Admin SDK); no client access at all.
    match /usernames/{username} {
      allow read, write: if false;
    }

    // users/{uid} and everything under it (workouts/sets, templates,
    // programs, dailyMacros, bodyweightArchives, measurements, cardioLogs,
    // crossfitLogs, dailyMissions, mobilityRoutines, mobilitySessions) —
    // only the account owner may read or write their own data.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /{subcollection}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;

        match /{nested=**} {
          allow read, write: if request.auth != null && request.auth.uid == uid;
        }
      }
    }

    // coaches/{coachUid}/clients/{athleteUid} — roster is written by the
    // server (Admin SDK) when a CoachClients row is migrated or created.
    // Only the coach who owns the roster may read it directly; no client writes.
    match /coaches/{coachUid}/clients/{athleteUid} {
      allow read: if request.auth != null && request.auth.uid == coachUid;
      allow write: if false;
    }

    // coaches/{coachUid}/leads/{leadId} — pre-signup intake submissions from
    // the public client-intake form. Written by the server (Admin SDK, via
    // POST /api/intake) on behalf of a prospect who has no account yet, so
    // there's no uid to check a write against — same reasoning as clients
    // above: server-only write, coach-only read.
    match /coaches/{coachUid}/leads/{leadId} {
      allow read: if request.auth != null && request.auth.uid == coachUid;
      allow write: if false;
    }

    // exercises/{exerciseId} — greenfield shared library (not yet built).
    // Readable by any signed-in user; writes stay server-side until a
    // moderation/ownership model exists for user-submitted (isCustom) entries.
    match /exercises/{exerciseId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Everything else: deny by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
