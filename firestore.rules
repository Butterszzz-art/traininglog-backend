// Firestore security rules — Phase 2 of the migration.
//
// Current architecture: the Express backend (Admin SDK) is the only thing
// that reads/writes Firestore today — Admin SDK requests always bypass these
// rules entirely. So right now these rules are a defense-in-depth backstop,
// not an active code path, for whenever the app starts reading Firestore
// directly from the client SDK (e.g. offline-first sync). Default is deny;
// each collection below opts in only what that future access pattern needs.
//
// Deploy with: firebase deploy --only firestore:rules (requires Firebase CLI
// logged in and linked to the project — see FIREBASE-SETUP.md).
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // usernames/{username} — pure uniqueness index for signup-complete.
    // Server-only (Admin SDK); no client access at all.
    match /usernames/{username} {
      allow read, write: if false;
    }

    // activitySyncTokens/{uid} — OAuth access/refresh tokens for the Activity
    // Sync (Google Health API) integration. Kept in its own top-level
    // collection instead of on the user doc so tokens are never exposed if
    // the client SDK ever reads users/{uid} directly. Server-only (Admin
    // SDK); no client access at all.
    match /activitySyncTokens/{uid} {
      allow read, write: if false;
    }

    // users/{uid} and everything under it (workouts/sets, templates,
    // programs, dailyMacros, bodyweightArchives, measurements, cardioLogs,
    // crossfitLogs, dailyMissions, mobilityRoutines, mobilitySessions,
    // activitySync) — only the account owner may read their own data. All
    // writes go through the server (Admin SDK): users/{uid} carries fields the
    // server trusts (userPlan, subStatus, totalVolume, referralCredits, ...),
    // so a client writing it directly could grant itself a paid plan or top
    // the leaderboard. The app never writes Firestore from the client.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;

      match /{subcollection}/{docId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;

        match /{nested=**} {
          allow read: if request.auth != null && request.auth.uid == uid;
          allow write: if false;
        }
      }
    }

    // coaches/{coachUid}/clients/{athleteUid} — roster is written by the
    // server (Admin SDK) when a CoachClients row is migrated or created.
    // Only the coach who owns the roster may read it directly; no client writes.
    match /coaches/{coachUid}/clients/{athleteUid} {
      allow read: if request.auth != null && request.auth.uid == coachUid;
      allow write: if false;
    }

    // coaches/{coachUid}/leads/{leadId} — pre-signup intake submissions from
    // the public client-intake form. Written by the server (Admin SDK, via
    // POST /api/intake) on behalf of a prospect who has no account yet, so
    // there's no uid to check a write against — same reasoning as clients
    // above: server-only write, coach-only read.
    // coaches/{coachUid}/plans/{planId} — master plans (drafts, approved,
    // published) written by the server (src/routes/plans.js). Only the coach
    // may read them; the client reads their published copy under
    // users/{uid}/plans, covered by the users/{uid} rule above.
    match /coaches/{coachUid}/plans/{planId} {
      allow read: if request.auth != null && request.auth.uid == coachUid;
      allow write: if false;
    }

    match /coaches/{coachUid}/leads/{leadId} {
      allow read: if request.auth != null && request.auth.uid == coachUid;
      allow write: if false;
    }

    // exercises/{exerciseId} — greenfield shared library (not yet built).
    // Readable by any signed-in user; writes stay server-side until a
    // moderation/ownership model exists for user-submitted (isCustom) entries.
    match /exercises/{exerciseId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // profiles/{username}, profileAvatars/{username}, profileReports/{id} —
    // public-facing profile (photo, display name, bio). Other users may only
    // see a profile subject to its owner's visibility setting (everyone /
    // coach / private), which needs a coach-link lookup rules can't express
    // cheaply, so every read and write goes through the API (Admin SDK).
    match /profiles/{username} {
      allow read, write: if false;
    }
    match /profileAvatars/{username} {
      allow read, write: if false;
    }
    match /profileReports/{reportId} {
      allow read, write: if false;
    }
    match /profileBlocks/{username} {
      allow read, write: if false;
    }

    // friendships/{a__b} — friend requests and accepted friendships. Written
    // and read only through the API (Admin SDK), which enforces that only the
    // recipient can accept.
    match /friendships/{pairId} {
      allow read, write: if false;
    }

    // groups/{id}, groupPosts/{id}, groupReports/{id} — community groups.
    // Only the API (Admin SDK) reads and writes them, since it checks
    // membership, friendships, blocks and the word filter.
    match /groups/{groupId} {
      allow read, write: if false;
    }
    match /groupPosts/{postId} {
      allow read, write: if false;
    }
    match /groupReports/{reportId} {
      allow read, write: if false;
    }

    // feedPosts, feedReports, shares, exerciseBests — community feed,
    // friend-to-friend sharing and the exercise leaderboard. API-only.
    match /feedPosts/{postId} {
      allow read, write: if false;
    }
    match /feedReports/{reportId} {
      allow read, write: if false;
    }
    match /shares/{shareId} {
      allow read, write: if false;
    }
    // Shared food search cache (src/nutrition/searchCache.js). API-only.
    match /foodSearchCache/{docId} {
      allow read, write: if false;
    }
    // Photos of meals sent to friends or posted in groups (src/mealShare.js).
    match /sharedMealPhotos/{photoId} {
      allow read, write: if false;
    }
    // Check-in comment threads (src/checkInComments.js) — server-only.
    match /checkInComments/{commentId} {
      allow read, write: if false;
    }
    match /exerciseBests/{bestId} {
      allow read, write: if false;
    }
    // Notifications and their per-user settings — server-only, see
    // src/routes/notifications.js.
    match /notifications/{notificationId} {
      allow read, write: if false;
    }
    match /notificationPrefs/{username} {
      allow read, write: if false;
    }
    // Phone push device tokens — server-only, see src/push.js.
    match /pushTokens/{token} {
      allow read, write: if false;
    }

    // Calendar feeds — server-only, see src/routes/calendar.js.
    match /calendarFeeds/{token} {
      allow read, write: if false;
    }
    match /calendarFeedOwners/{user} {
      allow read, write: if false;
    }
    // Everything else: deny by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
